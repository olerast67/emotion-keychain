    "extra_flags": "-DARDUINO_KEYCHAIN_REVB -DNRF52840_XXAA",
    "f_cpu": "64000000L",
    "hwids": [
      ["0x239A", "0x810B"],
      ["0x239A", "0x010B"]
    ],
    "usb_product": "Emotion Keychain",
    "mcu": "nrf52840",
    "variant": "keychain_revb",
    "bsp": {
      "name": "adafruit"
    },
    "softdevice": {
      "sd_flags": "-DS140",
